@inherits LayoutComponentBase

<div class="shell">
    <header class="shell-header">
        <div class="shell-brand">
            <img src="images/logo.png" alt="شعار إدارة الخدمات الطبية" width="40" height="40" />
            <div>
                <div class="shell-title">إدارة الخدمات الطبية</div>
                <div class="shell-subtitle" dir="ltr">MEDICAL SERVICES DIRECTORATE</div>
            </div>
        </div>
        <div class="shell-actions">
            <AuthorizeView>
                <Authorized>
                    <span class="shell-user">@context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</span>
                    <a class="btn-outline" href="/auth/logout" data-enhance-nav="false">تسجيل الخروج</a>


                </Authorized>
            </AuthorizeView>
        </div>
    </header>
    <main class="shell-main">
        @Body
    </main>
</div>
